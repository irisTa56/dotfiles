amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"

// Every check lives here. A file that a check's result depends on, its config and the
// mise.toml that pins its tool included, selects that check, so a commit that changes
// only the config still runs it. A check of the whole project is a mise task that a
// step calls, so it can also run by itself. mise.toml's entry points run hk.
//
// The `check` hook holds every check the repository has, and CI runs each of its steps
// by name (.github/workflows/ci.yml). The commit hook runs the same steps, each only
// when the commit stages a file its result depends on, and two scans of the staged
// change besides. It runs no fix, so nothing is stashed, and each check reads the
// working tree.

// The files every check depends on: the global mise config, which pins tools such as
// the Claude Code CLI, and this file. A new release of a tool declared at `latest`
// changes neither, so a commit can skip a check that release would fail; CI, which runs
// every step on every run, catches that, except for `plugins`, which CI does not run.
local tooling = List(".config/mise/config.toml", "hk.pkl")

// mise.toml as a step with a condition reads it, at `rev` (an empty `rev` is the index):
// every table but [dotfiles], [hooks] and [bootstrap], which none of those steps reads,
// with only the tasks in `tasks` kept. A step whose task lives in mise.toml names it, so an
// edit to another task, a link or a comment does not run the step. Where yq fails, the
// two never match, and the step runs.
local function miseRead(rev: String, tasks: List<String>): String =
  let (names = tasks.map((t) -> #"\"\#(t)\""#).join(", "))
    #"$(git show \#(rev):mise.toml | yq -p toml -o json -I0 'del(.dotfiles, .hooks, .bootstrap) | .tasks |= pick([\#(names)])')"#

// A step's condition on the commit: true when it stages a change under one of `paths` or
// to `tooling`, or a change to mise.toml that `miseRead` keeps. It is a `git diff
// --cached` rather than hk's `glob`, which matches only the staged files that are still
// there, so a commit that only deletes such a file would skip the step. The diff also
// sees a mode change, a symlink and a binary file, which `glob` leaves out by default,
// and reads the index `git commit <path>` builds, which git names in GIT_INDEX_FILE, as
// `git show :mise.toml` does. It runs at the repository's root.
local function staged(paths: List<String>, tasks: List<String>): String =
  #"!exec_ok("git diff --cached --quiet -- "# + (paths + tooling).join(" ") + #"")"#
    + #" || !exec_ok("git diff --cached --quiet -- mise.toml || { before=\#(miseRead("HEAD", tasks)) && test \"$before\" = \"\#(miseRead("", tasks))\"; }")"#

// The shell scripts: the task scripts under tasks/ and the shell startup fragments.
local shDirs = List("tasks", "zsh_fragments")
local shFiles = new FileSelector { glob = shDirs.map((d) -> "\(d)/**/*.sh") }
local shFind = "find \(shDirs.join(" ")) -name '*.sh' -exec"

// The checks that read files one at a time, run on the files a hook selects.
local fileSteps = new Mapping<String, Step> {
  ["rumdl"] = Builtins.rumdl
  ["shellcheck"] = (Builtins.shellcheck) {
    match_any = List(shFiles)
  }
  // shfmt takes its indentation from .editorconfig.
  ["shfmt"] = (Builtins.shfmt) {
    match_any = List(shFiles)
  }
  // biome.json names the files, the function-hooks module under global-hooks, and Biome
  // knows the file types it reads, so the step hands it every file and lets the two
  // choose; the builtin's glob would leave out types Biome reads, such as `.mts`.
  ["biome"] = (Builtins.biome) {
    glob = "**/*"
    check = "biome ci --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true {{files}}"
    fix = "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true {{files}}"
  }
  // mise.toml holds shell scripts, which stay readable in an editor and a diff only
  // where no line runs past 120 columns. grep counts characters, not bytes, under a
  // UTF-8 locale, and C.UTF-8 is one both macOS and CI's Ubuntu have. Only grep's
  // "no match" passes, so an error from grep fails the step too.
  ["mise-toml-width"] {
    glob = "mise.toml"
    check = #"rc=0; LC_ALL=C.UTF-8 grep -Hn -E '^.{121}' {{files}} || rc=$?; test $rc -eq 1 || { echo 'mise-toml-width: keep each line within 120 columns' >&2; exit 1; }"#
  }
}

// The same checks over every file they cover, for a commit that changes what their
// result depends on without staging a file they read.
local treeSteps = new Mapping<String, Step> {
  ["rumdl-tree"] {
    step_condition = staged(List(".rumdl.toml"), List())
    check = "rumdl check"
  }
  ["shellcheck-tree"] {
    step_condition = staged(List(), List())
    check = "\(shFind) shellcheck {} +"
  }
  ["shfmt-tree"] {
    step_condition = staged(List(".editorconfig"), List())
    check = "\(shFind) shfmt -d {} +"
  }
  ["biome-tree"] {
    step_condition = staged(List("biome.json"), List())
    check = "biome ci --error-on-warnings"
  }
}

// The checks of the whole project, each a mise task that also runs by itself.
local projectSteps = new Mapping<String, Step> {
  ["rust"] {
    check = "mise run qa:rust:crates"
  }
  ["skills-size"] {
    check = "mise run qa:rust:skills"
  }
  ["config"] {
    check = "mise run qa:config"
  }
  ["links-offline"] {
    check = "mise run qa:links:offline"
  }
  // CI does not run this one: `claude plugin validate` needs the Claude Code CLI, which
  // CI does not install.
  ["plugins"] {
    check = "mise run qa:plugins"
  }
}

hooks {
  ["check"] {
    steps {
      ...fileSteps
      ...projectSteps
    }
  }
  ["fix"] {
    fix = true
    steps {
      ...fileSteps
    }
  }
  ["pre-commit"] {
    steps {
      ...fileSteps
      ...treeSteps
      // The Rust tests run the task wrappers and scripts under tasks/ and the tools the
      // mise config declares, so a change to either runs them as a change to rust/ does.
      ["rust"] = (projectSteps["rust"]) {
        step_condition = staged(List("rust", "tasks"), List("qa:rust:crates"))
      }
      ["skills-size"] = (projectSteps["skills-size"]) {
        step_condition = staged(List(".claude/skills", "rust"), List("qa:rust:skills"))
      }
      // Every commit, as the files the `qa:config:` tasks read grow with the tasks.
      ["config"] = projectSteps["config"]
      // Any change can break a link: a renamed file breaks the links to it from files
      // the commit does not touch.
      ["links-offline"] = projectSteps["links-offline"]
      // `claude plugin validate .claude/skills` reads the skills apm installs there too,
      // which a change to apm.yml or apm.lock.yaml brings in.
      ["plugins"] = (projectSteps["plugins"]) {
        step_condition = staged(List(".claude/skills", "apm.yml", "apm.lock.yaml"), List("qa:plugins"))
      }
      // The shared tasks that read the staged change itself, which only a commit has.
      ["secrets"] {
        check = "mise run secrets:commit-scan"
      }
      ["links-commit-check"] {
        check = "mise run links:commit-check"
      }
    }
  }
}
