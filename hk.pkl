amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

// The commit hook: mise.toml's pre-commit, less the checks a commit cannot change the
// result of. The steps run in parallel. There is no fix step, so nothing is stashed,
// and each check reads the working tree as `mise run pre-commit` does.
//
// A step is chosen by a `git diff --cached` over the paths whose change can change its
// result, rather than by `glob`, which hk matches against the staged files that are
// still there: a commit that only deletes such a file would skip the step. The diff also
// sees a mode change, a symlink and a binary file, which `glob` leaves out by default,
// and reads the index `git commit <path>` builds, which git names in GIT_INDEX_FILE.
// Both conditions run at the repository's root.
hooks {
  ["pre-commit"] {
    steps {
      // Every other check, a `qa:` task added later included, through mise.toml's
      // pre-commit. MISE_TASK_SKIP keeps the tasks the steps below run, and any the
      // commit was given to skip.
      ["checks"] {
        check = #"MISE_TASK_SKIP="${MISE_TASK_SKIP:+$MISE_TASK_SKIP,}qa:rust:crates,plugins:check" mise run pre-commit"#
      }
      // The Rust tests run the task wrappers and scripts under tasks/ and the tools the
      // mise config declares, so a change to either runs them as a change to rust/ does.
      // A new release of a tool declared at `latest` changes no file here; CI, which
      // runs every test on every run, is what catches that.
      ["rust"] {
        step_condition = #"!exec_ok("git diff --cached --quiet -- rust tasks mise.toml .config/mise/config.toml")"#
        check = "mise run qa:rust:crates"
      }
      // `claude plugin validate .claude/skills` reads the skills apm installs there too,
      // which a change to apm.yml or apm.lock.yaml brings in; mise.toml defines the task.
      ["plugins"] {
        step_condition = #"!exec_ok("git diff --cached --quiet -- .claude/skills apm.yml apm.lock.yaml mise.toml")"#
        check = "mise run plugins:check"
      }
    }
  }
}
