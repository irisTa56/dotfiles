{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "rust": {
      "release-type": "rust",
      "component": "dotfiles-tasks",
      "exclude-paths": ["rust/crates/local"],
      "include-component-in-tag": true,
      "extra-files": [
        {
          "type": "generic",
          "path": "/tasks/links/commit-check.sh"
        },
        {
          "type": "generic",
          "path": "/tasks/secrets/push-scan.sh"
        },
        {
          "type": "generic",
          "path": "/tasks/skills/size-check.sh"
        },
        {
          "type": "generic",
          "path": "/tasks/upstream/pin-check.sh"
        }
      ],
      "draft": true,
      "force-tag-creation": true
    }
  }
}
