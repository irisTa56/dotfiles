{
  "idleCompaction": false,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/reply_language_stop\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Artifact",
      "ArtifactCheck",
      "ArtifactComments",
      "ArtifactData",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills",
      "Workflow",
      "mcp__computer-use__*"
    ]
  },
  "enabledPlugins": {
    "cowork-plugin-management@inline": false,
    "cowork-plugin-management@synced": false
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  }
}
