{
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(//**/*-key.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.kdbx)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_dsa*)",
      "Read(//**/id_ecdsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/credentials.json)",
      "Read(//**/client_secret*.json)",
      "Read(//**/.netrc)",
      "Read(//**/.git-credentials)",
      "Read(//**/.pgpass)",
      "Read(//**/.npmrc)",
      "Read(//**/.pypirc)",
      "Read(//**/.dockercfg)",
      "Read(//**/*.tfstate)",
      "Read(//**/*.tfvars)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/rclone/**)",
      "Read(~/.config/gws/**)",
      "Read(~/.notebooklm/**)"
    ],
    "ask": [
      "Read(//**/*.pem)"
    ]
  }
}
