{
  "modules": ["./index.ts"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/dotfiles-local\" ask-email-in-request"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/dotfiles-local\" reply-language-stop"
          }
        ]
      }
    ]
  }
}
