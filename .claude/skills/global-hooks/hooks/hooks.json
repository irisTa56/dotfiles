{
  "modules": ["./index.ts"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/dotfiles-local\" block-piped-git-push"
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/dotfiles-local\" block-bsd-sed-inplace"
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/dotfiles-local\" block-bsd-stat-format"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/ask-email-in-request.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/reply-language-stop.ts\""
          }
        ]
      }
    ]
  }
}
